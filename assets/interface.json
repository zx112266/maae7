{
    "interface_version": 2,
    "name": "maae7",
    "description": "第七史诗自动化脚本，竞技场/讨伐/迷宫/骑士团/商店/签到/圣域/宠物小屋",
    "contact": "自用项目",
    "license": "MIT",
    "welcome": "欢迎使用maae7第七史诗脚本",
    "github": "https://github.com/zx112266/maae7",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": ".*",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "start_game"
        },
        {
            "name": "竞技场自动战斗",
            "entry": "arena_detect"
        },
        {
            "name": "欧勒毕斯指南领取奖励",
            "entry": "guide_detect"
        },
        {
            "name": "骑士团世界首领战",
            "entry": "guild_detect"
        },
        {
            "name": "讨伐地狱级快速战斗",
            "entry": "hunt_detect_battle"
        },
        {
            "name": "迷宫商人购买强化石",
            "entry": "labyrinth_entry"
        },
        {
            "name": "宠物小屋领养宠物",
            "entry": "detect_pet_house"
        },
        {
            "name": "圣域精灵之森照料",
            "entry": "detect_san_entrance"
        },
        {
            "name": "商店领取免费物资",
            "entry": "shop_detect"
        },
        {
            "name": "关闭签到及各类弹窗",
            "entry": "sign_check_reward"
        },
        {
            "name": "誓约召唤（免费优先）",
            "entry": "summon_enter"
        },
        {
            "name": "秘密商店购买誓约书签",
            "entry": "secret_shop_enter",
            "option": [
                "秘密商店刷新次数"
            ]
        },
        {
            "name": "欧多马顿塔（赛季周本）",
            "entry": "odomaton_enter"
        }
    ],
    "option": {
        "秘密商店刷新次数": {
            "type": "select",
            "label": "刷新次数上限",
            "description": "没刷到誓约书签时，最多花天空石刷新几次。每次消耗 3 天空石。",
            "default_case": "不刷新",
            "cases": [
                {
                    "name": "不刷新",
                    "label": "不刷新（只看一眼，不消耗天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "5",
                    "label": "5 次（约 15 天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": true,
                            "max_hit": 5
                        }
                    }
                },
                {
                    "name": "10",
                    "label": "10 次（约 30 天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": true,
                            "max_hit": 10
                        }
                    }
                },
                {
                    "name": "20",
                    "label": "20 次（约 60 天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": true,
                            "max_hit": 20
                        }
                    }
                },
                {
                    "name": "30",
                    "label": "30 次（约 90 天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": true,
                            "max_hit": 30
                        }
                    }
                },
                {
                    "name": "50",
                    "label": "50 次（约 150 天空石）",
                    "pipeline_override": {
                        "secret_refresh": {
                            "enabled": true,
                            "max_hit": 50
                        }
                    }
                }
            ]
        }
    }
}