{
    "sign_check_confirm": {
        "desc": "识别确认弹窗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1003, 638, 134, 53],
                "expected": ["确认"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [1052, 667]
            }
        },
        "timeout": 5000,
        "rate_limit": 500,
        "on_error": ["sign_click_cancel"],
        "next": ["sign_check_buff"]
    },
    "sign_click_cancel": {
        "desc": "确认识别失败，点击取消位置3次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [405, 19]
            }
        },
        "repeat": 3,
        "repeat_delay": 500,
        "next": ["sign_check_buff"]
    },
    "sign_check_buff": {
        "desc": "识别增益效果弹窗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [177, 109, 131, 45],
                "expected": ["增益效果"]
            }
        },
        "timeout": 8000,
        "rate_limit": 500,
        "on_error": ["sign_buff_failed_click"],
        "next": ["sign_close_buff"]
    },
    "sign_buff_failed_click": {
        "desc": "增益效果识别失败，点击取消位置3次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [405, 19]
            }
        },
        "repeat": 3,
        "repeat_delay": 500,
        "next": ["sign_end"]
    },
    "sign_close_buff": {
        "desc": "关闭增益效果弹窗，点击3次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [327, 16]
            }
        },
        "repeat": 3,
        "repeat_delay": 500,
        "post_wait_freezes": {
            "time": 500,
            "target": [0, 0, 1280, 720]
        },
        "next": ["sign_end"]
    },
    "sign_end": {
        "desc": "签到流程结束",
        "recognition": "DirectHit",
        "action": "DoNothing"
    }
}